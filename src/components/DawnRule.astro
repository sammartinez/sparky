---
/*
  The one bold moment on the page. A single rule spanning the collection
  window, with a tick for every story placed at the hour it broke and sized by
  its traction. Reading it left to right tells you whether this morning's brief
  is a slow burn or something that all landed in the last four hours.
*/
interface Props {
  stories: { title: string; createdAt: string; normalized: number }[];
  /** Right edge of the rule. */
  generatedAt: string;
  windowHours?: number;
}

const { stories, generatedAt, windowHours = 36 } = Astro.props;

const end = new Date(generatedAt).getTime();
const span = windowHours * 3_600_000;

const ticks = stories
  .map((s) => {
    const age = end - new Date(s.createdAt).getTime();
    return {
      title: s.title,
      // 0% = oldest edge of the window, 100% = now.
      left: Math.min(100, Math.max(0, (1 - age / span) * 100)),
      height: 5 + Math.round(s.normalized * 17),
      hot: s.normalized >= 0.9,
    };
  })
  .sort((a, b) => a.left - b.left);

const hourMarks = [windowHours, 24, 12, 0].filter((h) => h <= windowHours);
---

<figure class="mt-2 mb-12">
  <div class="relative h-14" aria-hidden="true">
    <!-- Hour gridlines -->
    {
      hourMarks.map((h) => (
        <span
          class="bg-rule absolute bottom-0 w-px"
          style={`left:${(1 - h / windowHours) * 100}%; height:9px;`}
        />
      ))
    }

    <!-- One tick per story, bottom-aligned on the rule -->
    {
      ticks.map((t) => (
        <span
          class={`absolute bottom-0 w-[3px] rounded-t-[2px] ${t.hot ? "bg-accent2" : "bg-accent"}`}
          style={`left:${t.left}%; height:${t.height}px; opacity:${t.hot ? 1 : 0.45};`}
          title={t.title}
        />
      ))
    }

    <div class="border-ink absolute right-0 bottom-0 left-0 border-b"></div>
  </div>

  <figcaption class="eyebrow mt-2 flex justify-between">
    {
      hourMarks.map((h) => (
        <span>{h === 0 ? "now" : `−${h}h`}</span>
      ))
    }
  </figcaption>

  <p class="sr-only">
    Timeline showing when each of the {stories.length} stories first appeared, across
    the last {windowHours} hours.
  </p>
</figure>
