---
import { orderedAppearances, relativeAge } from "../lib/brief";

interface Appearance {
  source: string;
  label: string;
  points: number | null;
  comments: number | null;
  discussionUrl?: string;
}

interface Props {
  rank: number;
  title: string;
  url: string;
  domain: string;
  createdAt: string;
  why: string;
  normalized: number;
  appearances: Appearance[];
  /** Freeze "now" so every row on a page agrees. */
  now?: number;
}

const {
  rank,
  title,
  url,
  domain,
  createdAt,
  why,
  normalized,
  appearances,
  now = Date.now(),
} = Astro.props;

const badges = orderedAppearances(appearances);
const corroborated = badges.length > 1;
const barWidth = Math.max(4, Math.round(normalized * 100));
---

<article class="border-rule grid grid-cols-[2.25rem_1fr] gap-x-3 border-b py-6 sm:gap-x-5">
  <!-- Rank + traction. The bar is the only saffron on the page. -->
  <div class="pt-1">
    <span class="text-muted block font-mono text-xs tabular-nums">
      {String(rank).padStart(2, "0")}
    </span>
    <span class="bg-rule mt-2 block h-[3px] w-full overflow-hidden">
      <span class="bg-saffron block h-full" style={`width:${barWidth}%`}></span>
    </span>
  </div>

  <div class="min-w-0">
    <h2 class="text-[1.35rem] leading-snug font-medium sm:text-2xl">
      <a
        href={url}
        rel="noopener noreferrer"
        class="decoration-rule hover:decoration-pine underline decoration-1 underline-offset-[5px] transition-colors"
      >
        {title}
      </a>
    </h2>

    {why && <p class="text-muted mt-2 text-[0.98rem] leading-relaxed italic">{why}</p>}

    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[0.7rem]">
      <span class="text-muted">{domain}</span>

      {
        badges.map((a) => (
          <a
            href={a.discussionUrl ?? url}
            rel="noopener noreferrer"
            class="border-rule text-muted hover:border-pine hover:text-pine inline-flex items-center gap-1.5 border px-1.5 py-0.5 no-underline transition-colors"
          >
            <span>{a.label}</span>
            {a.points !== null && <span class="tabular-nums opacity-70">{a.points}</span>}
          </a>
        ))
      }

      {
        corroborated && (
          <span class="text-clay" title="Picked up by more than one community">
            ×{badges.length} sources
          </span>
        )
      }

      <span class="text-muted ml-auto">{relativeAge(createdAt, now)}</span>
    </div>
  </div>
</article>
