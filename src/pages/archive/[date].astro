---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import BriefGrid from "../../components/BriefGrid.astro";
import { allDigests, formatDate, href } from "../../lib/brief";

export const getStaticPaths = (async () => {
  const digests = await allDigests();
  return digests.map((entry, i) => ({
    params: { date: entry.id },
    props: {
      entry,
      newer: digests[i - 1] ?? null,
      older: digests[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, newer, older } = Astro.props as Props;
const now = new Date(entry.data.generatedAt).getTime();
---

<Base
  title={`${entry.data.date} — Sparky News`}
  standfirst={formatDate(entry.data.date)}
>
  <BriefGrid stories={entry.data.stories} generatedAt={entry.data.generatedAt} now={now} />

  <nav class="mt-10 flex items-center justify-between font-mono text-xs">
    {
      older ? (
        <a href={href(`archive/${older.id}`)} class="hover:text-accent">← {older.id}</a>
      ) : (
        <span />
      )
    }
    <a href={href("archive")} class="hover:text-accent">All briefs</a>
    {
      newer ? (
        <a href={href(`archive/${newer.id}`)} class="hover:text-accent">{newer.id} →</a>
      ) : (
        <span />
      )
    }
  </nav>
</Base>
