---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import BriefGrid from "../../components/BriefGrid.astro";
import BriefNav from "../../components/BriefNav.astro";
import { allDigests, formatDate } from "../../lib/brief";

export const getStaticPaths = (async () => {
  const digests = await allDigests();
  return digests.map((entry, i) => ({
    params: { date: entry.id },
    props: {
      entry,
      newer: digests[i - 1] ?? null,
      older: digests[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, newer, older } = Astro.props as Props;
const now = new Date(entry.data.generatedAt).getTime();
---

<Base
  title={`${entry.data.date} — Sparky News`}
  heading={formatDate(entry.data.date)}
>
  <BriefGrid
    stories={entry.data.stories}
    generatedAt={entry.data.generatedAt}
    now={now}
    windowHours={entry.data.windowHours}
  />

  <BriefNav older={older?.id} newer={newer?.id} />
</Base>
