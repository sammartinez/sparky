---
import Base from "../../layouts/Base.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import {
  BRIEF_COUNT_PLURAL,
  BRIEF_COUNT_SINGULAR,
  HEADING_ARCHIVE,
  TITLE_ARCHIVE,
} from "../../constants";
import { allDigests } from "../../lib/brief";

const digests = await allDigests();
---

<Base
  title={TITLE_ARCHIVE}
  heading={HEADING_ARCHIVE}
  standfirst={`${digests.length} ${digests.length === 1 ? BRIEF_COUNT_SINGULAR : BRIEF_COUNT_PLURAL}`}
>
  <ArchiveList digests={digests} />
</Base>
