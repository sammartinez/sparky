---
import Base from "../layouts/Base.astro";
import DawnRule from "../components/DawnRule.astro";
import StoryCard from "../components/StoryCard.astro";
import { allDigests, formatDate, href } from "../lib/brief";

const digests = await allDigests();
const today = digests[0];
const previous = digests[1];

// One clock for the whole page so the ages agree with each other.
const now = today ? new Date(today.data.generatedAt).getTime() : Date.now();

// Lead story full-width, next four as a 2x2 grid, the rest as a compact list.
const [feature, ...rest] = today?.data.stories ?? [];
const gridStories = rest.slice(0, 4);
const compactStories = rest.slice(4);
---

<Base
  title="Sparky News — Today's AI brief"
  standfirst={today ? formatDate(today.data.date) : "No brief yet"}
>
  {
    !today && (
      <section class="border-rule border-t py-16">
        <p class="text-muted text-lg">
          Nothing here yet. Run <code class="font-mono text-sm">npm run digest</code> to
          build the first brief, or trigger the Daily brief workflow from the Actions
          tab.
        </p>
      </section>
    )
  }

  {
    today && (
      <>
        <DawnRule
          stories={today.data.stories}
          generatedAt={today.data.generatedAt}
        />

        {today.data.stories.length === 0 ? (
          <p class="text-muted border-rule border-t py-12">
            Quiet morning — nothing cleared the bar.
          </p>
        ) : (
          <div class="grid grid-cols-6 gap-x-[1.1rem] gap-y-9">
            {feature && <StoryCard rank={1} now={now} variant="feature" {...feature} />}
            {gridStories.map((story, i) => (
              <StoryCard rank={i + 2} now={now} variant="grid" {...story} />
            ))}
            {compactStories.length > 0 && (
              <div class="col-span-6">
                <h3 class="eyebrow mt-1 mb-2.5">Also today</h3>
                <div class="flex flex-col gap-[0.9rem]">
                  {compactStories.map((story, i) => (
                    <StoryCard
                      rank={i + gridStories.length + 2}
                      now={now}
                      variant="compact"
                      {...story}
                    />
                  ))}
                </div>
              </div>
            )}
          </div>
        )}

        <nav class="mt-10 flex items-center justify-between font-mono text-xs">
          {previous ? (
            <a href={href(`archive/${previous.id}`)} class="hover:text-accent">
              ← {previous.data.date}
            </a>
          ) : (
            <span />
          )}
          <a href={href("archive")} class="hover:text-accent">All briefs →</a>
        </nav>
      </>
    )
  }
</Base>
