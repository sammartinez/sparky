---
import Base from "../layouts/Base.astro";
import BriefGrid from "../components/BriefGrid.astro";
import BriefNav from "../components/BriefNav.astro";
import { HEADING_NO_BRIEF } from "../constants";
import { allDigests, formatDate } from "../lib/brief";

const digests = await allDigests();
const today = digests[0];
const previous = digests[1];

// One clock for the whole page so the ages agree with each other.
const now = today ? new Date(today.data.generatedAt).getTime() : Date.now();
---

<Base
  title="Sparky News — Today's AI brief"
  heading={today ? formatDate(today.data.date) : HEADING_NO_BRIEF}
>
  {
    !today && (
      <section class="border-rule border-t py-16">
        <p class="text-muted text-lg">
          Nothing here yet. Run <code class="font-mono text-sm">npm run digest</code> to
          build the first brief, or trigger the Daily brief workflow from the Actions
          tab.
        </p>
      </section>
    )
  }

  {
    today && (
      <>
        <BriefGrid
          stories={today.data.stories}
          generatedAt={today.data.generatedAt}
          now={now}
          windowHours={today.data.windowHours}
        />

        <BriefNav older={previous?.id} />
      </>
    )
  }
</Base>
