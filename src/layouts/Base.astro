---
import "../styles/global.css";
import { SITE_NAME } from "../constants";
import { href } from "../lib/brief";
import SparkMark from "../components/SparkMark.astro";

interface Props {
  title: string;
  description?: string;
  /** The page's only h1, shown under the wordmark. */
  heading: string;
  /** Optional eyebrow line under the heading. */
  standfirst?: string;
}

const {
  title,
  description = "A daily read on what the AI world is actually talking about.",
  heading,
  standfirst,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://localhost");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={href("favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="icon" href={href("favicon-16.png")} sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href={href("apple-touch-icon.png")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href={href("rss.xml")}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;1,7..72,400;1,7..72,500&family=Spline+Sans+Mono:wght@400;500&display=swap"
    />
  </head>

  <body class="bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:bg-accent focus:text-paper focus:fixed focus:top-3 focus:left-3 focus:z-10 focus:rounded focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <header class="pt-10 pb-6 sm:pt-16">
        <a href={href("/")} class="inline-flex items-center gap-3 no-underline">
          <SparkMark class="h-9 w-9 shrink-0 sm:h-12 sm:w-12" />
          <span class="font-display text-[2.3rem] leading-[0.95] font-medium sm:text-5xl">
            {SITE_NAME}
          </span>
        </a>
        <h1 class="text-muted mt-3 font-mono text-xs tracking-[0.14em] uppercase">
          {heading}
        </h1>
        {standfirst && <p class="eyebrow mt-1">{standfirst}</p>}
      </header>

      <main id="main">
        <slot />
      </main>

      <footer
        class="text-muted mt-20 border-t border-rule py-8 font-mono text-xs leading-relaxed"
      >
        <p>
          Assembled twice a day from Hacker News, Lobsters, Hugging Face, and a
          short list of feeds. Ranked by traction relative to each source,
          weighted for cross-posting, decayed by age.
        </p>
        <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
          <a href={href("/")} class="hover:text-accent">Today</a>
          <a href={href("archive")} class="hover:text-accent">Archive</a>
          <a href={href("rss.xml")} class="hover:text-accent">RSS</a>
        </p>
      </footer>
    </div>
  </body>
</html>
