---
import "../styles/global.css";
import { href } from "../lib/brief";

interface Props {
  title: string;
  description?: string;
  /** Shown under the wordmark — usually the date this page covers. */
  standfirst?: string;
}

const {
  title,
  description = "A daily read on what the AI world is actually talking about.",
  standfirst,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://localhost");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="color-scheme" content="light dark" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Sparky"
      href={href("rss.xml")}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..500&display=swap"
    />
  </head>

  <body class="bg-paper text-ink">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <header class="pt-10 pb-6 sm:pt-16">
        <a href={href("/")} class="inline-block no-underline">
          <h1
            class="font-display text-[2.6rem] leading-[0.95] font-semibold tracking-tight sm:text-6xl"
            style="font-stretch: 92%;"
          >
            Sparky
          </h1>
        </a>
        <p class="eyebrow mt-3">
          {standfirst ?? "What the AI world is talking about"}
        </p>
      </header>

      <slot />

      <footer
        class="text-muted mt-20 border-t border-rule py-8 font-mono text-xs leading-relaxed"
      >
        <p>
          Assembled every morning from Hacker News, Reddit, Lobsters, Hugging
          Face, and a short list of feeds. Ranked by traction relative to each
          source, weighted for cross-posting, decayed by age.
        </p>
        <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
          <a href={href("/")} class="hover:text-pine">Today</a>
          <a href={href("archive")} class="hover:text-pine">Archive</a>
          <a href={href("rss.xml")} class="hover:text-pine">RSS</a>
        </p>
      </footer>
    </div>
  </body>
</html>
