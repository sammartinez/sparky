{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "canonicalUrl": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "appearances": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "hn",
                    "reddit",
                    "lobsters",
                    "hf",
                    "rss"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "points": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "comments": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "discussionUrl": {
                  "type": "string"
                }
              },
              "required": [
                "source",
                "label",
                "points",
                "comments"
              ]
            }
          },
          "normalized": {
            "type": "number"
          },
          "score": {
            "type": "number"
          },
          "aiScore": {
            "type": "number"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "canonicalUrl",
          "domain",
          "createdAt",
          "appearances",
          "normalized",
          "score",
          "aiScore",
          "why"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "generatedAt",
    "stories"
  ]
}