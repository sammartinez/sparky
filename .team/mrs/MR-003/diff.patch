 /** Small helpers for asserting on rendered HTML strings. */
+import { expect } from "vitest";
 
 export interface Heading {
   level: number;
@@ -102,3 +103,19 @@ export function classesOfParentOf(
 export function readText(html: string): string {
   return stripTags(html, "");
 }
+
+/** Every link in the first <nav> inside <main>, in document order. */
+export function mainNavLinks(html: string): Element[] {
+  return elements(innerOf(innerOf(html, "main"), "nav"), "a");
+}
+
+/** Classes that make a navigation link a 44px-tall, vertically centred tap target. */
+const TAP_TARGET_CLASSES = ["inline-flex", "min-h-11", "items-center"];
+
+/** Asserts there is at least one link and every one is a 44px tap target. */
+export function expectTapTargets(links: Element[]): void {
+  expect(links.length).toBeGreaterThan(0);
+  for (const link of links) {
+    expect(link.classes).toEqual(expect.arrayContaining(TAP_TARGET_CLASSES));
+  }
+}
diff --git a/tests/support/stories.ts b/tests/support/stories.ts
index 877fbdd..b235710 100644
--- a/tests/support/stories.ts
+++ b/tests/support/stories.ts
@@ -17,3 +17,21 @@ export function story(
     ...overrides,
   };
 }
+
+/**
+ * A digest collection entry for the ISO date `id`, shaped like what
+ * `getCollection("digests")` returns, with one story per title.
+ */
+export function digestEntry(id: string, titles: string[] = []) {
+  const generatedAt = `${id}T12:00:00.000Z`;
+  return {
+    id,
+    collection: "digests",
+    data: {
+      date: id,
+      generatedAt,
+      windowHours: 36,
+      stories: titles.map((title, i) => story(i + 1, generatedAt, { title })),
+    },
+  };
+}
