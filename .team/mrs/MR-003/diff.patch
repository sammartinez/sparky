diff --git a/src/components/ArchiveList.astro b/src/components/ArchiveList.astro
new file mode 100644
index 0000000..7650844
--- /dev/null
+++ b/src/components/ArchiveList.astro
@@ -0,0 +1,55 @@
+---
+import {
+  LED_WITH_LABEL,
+  NO_BRIEFS_MESSAGE,
+  STORIES_LABEL,
+} from "../constants";
+import { briefHref, formatDate, groupByMonth } from "../lib/brief";
+
+interface Props {
+  /** Newest first. */
+  digests: {
+    id: string;
+    data: { date: string; stories: { title: string }[] };
+  }[];
+}
+
+const { digests } = Astro.props;
+const months = groupByMonth(digests);
+---
+
+{
+  digests.length === 0 ? (
+    <p class="text-muted border-rule border-t py-12">{NO_BRIEFS_MESSAGE}</p>
+  ) : (
+    months.map((month) => (
+      <section class="mb-10">
+        <h2 class="eyebrow mb-2.5 text-xs">{month.label}</h2>
+        <ol class="border-rule border-t">
+          {month.entries.map((digest) => (
+            <li>
+              <a
+                href={briefHref(digest.id)}
+                class="border-rule hover:bg-panel block border-b px-2 py-5 no-underline transition-colors"
+              >
+                <div class="flex items-baseline justify-between gap-4">
+                  <span class="font-display text-lg font-medium">
+                    {formatDate(digest.data.date)}
+                  </span>
+                  <span class="text-muted font-mono text-xs whitespace-nowrap">
+                    {digest.data.stories.length} {STORIES_LABEL}
+                  </span>
+                </div>
+                {digest.data.stories[0] && (
+                  <p class="text-muted mt-1 line-clamp-2 text-sm">
+                    {LED_WITH_LABEL} {digest.data.stories[0].title}
+                  </p>
+                )}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </section>
+    ))
+  )
+}
diff --git a/src/components/BriefNav.astro b/src/components/BriefNav.astro
new file mode 100644
index 0000000..a61dbd0
--- /dev/null
+++ b/src/components/BriefNav.astro
@@ -0,0 +1,42 @@
+---
+import {
+  ALL_BRIEFS_LABEL,
+  NEXT_ARROW,
+  PREV_ARROW,
+  ROUTE_ARCHIVE,
+} from "../constants";
+import { briefHref, formatShortDate, href } from "../lib/brief";
+
+interface Props {
+  /** ISO date of the brief before this one, when there is one. */
+  older?: string | null;
+  /** ISO date of the brief after this one, when there is one. */
+  newer?: string | null;
+}
+
+const { older, newer } = Astro.props;
+
+const linkClass = "hover:text-accent inline-flex min-h-11 items-center";
+---
+
+<nav class="mt-10 grid grid-cols-[1fr_auto_1fr] items-center gap-x-4 font-mono text-xs">
+  {
+    older ? (
+      <a href={briefHref(older)} class:list={[linkClass, "justify-self-start"]}>
+        {PREV_ARROW} {formatShortDate(older)}
+      </a>
+    ) : (
+      <span />
+    )
+  }
+  <a href={href(ROUTE_ARCHIVE)} class={linkClass}>{ALL_BRIEFS_LABEL}</a>
+  {
+    newer ? (
+      <a href={briefHref(newer)} class:list={[linkClass, "justify-self-end"]}>
+        {formatShortDate(newer)} {NEXT_ARROW}
+      </a>
+    ) : (
+      <span />
+    )
+  }
+</nav>
