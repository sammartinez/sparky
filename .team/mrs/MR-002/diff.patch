diff --git a/tests/components/StoryCard.layout.test.ts b/tests/components/StoryCard.layout.test.ts
new file mode 100644
index 0000000..59f1701
--- /dev/null
+++ b/tests/components/StoryCard.layout.test.ts
@@ -0,0 +1,80 @@
+import { test, expect } from "vitest";
+import { experimental_AstroContainer as AstroContainer } from "astro/container";
+import StoryCard from "../../src/components/StoryCard.astro";
+import { classesOfParentOf, elements } from "../support/html";
+import { STORY_DOMAIN, storyCardProps } from "../support/storyCard";
+
+function baseProps(overrides: Record<string, unknown> = {}) {
+  return storyCardProps({ variant: "grid", ...overrides });
+}
+
+async function render(props: Record<string, unknown>) {
+  const container = await AstroContainer.create();
+  return container.renderToString(StoryCard, { props });
+}
+
+/** Classes of the metadata row: the element whose first child is the domain. */
+function metaRow(html: string): string[] {
+  return classesOfParentOf(html, "div", STORY_DOMAIN);
+}
+
+test("the grid card lays its content out as a column", async () => {
+  const html = await render(baseProps());
+  const [card] = elements(html, "article");
+
+  expect(card.classes).toContain("flex");
+  expect(card.classes).toContain("flex-col");
+});
+
+test("the grid card pushes its metadata row to the bottom edge", async () => {
+  const html = await render(baseProps());
+
+  expect(metaRow(html)).toContain("mt-auto");
+});
+
+test("the grid card's metadata row has no second top margin fighting the push to the bottom", async () => {
+  const html = await render(baseProps());
+  const margins = metaRow(html).filter((c) => /^-?mt-/.test(c));
+
+  expect(margins).toEqual(["mt-auto"]);
+});
+
+test("the grid card's metadata row keeps its top rule and the padding above it", async () => {
+  const html = await render(baseProps());
+  const row = metaRow(html);
+
+  expect(row).toEqual(
+    expect.arrayContaining(["border-rule", "border-t", "pt-3.5"]),
+  );
+});
+
+test("the grid card still has the half-width column span and its padding", async () => {
+  const html = await render(baseProps());
+  const [card] = elements(html, "article");
+
+  expect(card.classes).toEqual(
+    expect.arrayContaining([
+      "col-span-6",
+      "sm:col-span-3",
+      "px-6",
+      "py-6",
+      "relative",
+    ]),
+  );
+});
+
+test("the grid card's rank number renders exactly as before", async () => {
+  const html = await render(baseProps({ rank: 3 }));
+
+  expect(html).toContain(
+    '<span class="bg-accent text-paper absolute -top-3.5 left-4 px-2.5 py-1 font-mono text-xs tabular-nums">03</span>',
+  );
+});
+
+test("the grid card's rank bar renders exactly as before", async () => {
+  const html = await render(baseProps({ normalized: 0.6 }));
+
+  expect(html).toMatch(
+    /<span class="bg-rule mt-2 block h-0\.75 w-full overflow-hidden rounded-full">\s*<span class="bg-accent block h-full" style="width:60%"><\/span>\s*<\/span>/,
+  );
+});
diff --git a/tests/components/StoryCard.title.test.ts b/tests/components/StoryCard.title.test.ts
new file mode 100644
index 0000000..25ebfb2
--- /dev/null
+++ b/tests/components/StoryCard.title.test.ts
@@ -0,0 +1,68 @@
+import { describe, test, expect } from "vitest";
+import { experimental_AstroContainer as AstroContainer } from "astro/container";
+import StoryCard from "../../src/components/StoryCard.astro";
+import { anchorsTo, readText } from "../support/html";
+import { STORY_URL, storyCardProps } from "../support/storyCard";
+
+/** The badge has its own discussion url, so the title is the only link to STORY_URL. */
+function baseProps(overrides: Record<string, unknown> = {}) {
+  return storyCardProps({
+    appearances: [
+      {
+        source: "hn",
+        label: "HN",
+        points: 150,
+        comments: 40,
+        discussionUrl: "https://news.ycombinator.com/item?id=1",
+      },
+    ],
+    ...overrides,
+  });
+}
+
+async function titleLink(props: Record<string, unknown>) {
+  const container = await AstroContainer.create();
+  const html = await container.renderToString(StoryCard, { props });
+  const links = anchorsTo(html, STORY_URL);
+  expect(links).toHaveLength(1);
+  return links[0];
+}
+
+describe.each(["feature", "grid", "compact"])("%s variant", (variant) => {
+  test("the title link is underlined at rest in the muted colour", async () => {
+    const link = await titleLink(baseProps({ variant }));
+
+    expect(link.classes).toContain("underline");
+    expect(link.classes).toContain("decoration-muted");
+    expect(link.classes).not.toContain("decoration-rule");
+  });
+
+  test("the title text and its underline turn the accent colour on hover", async () => {
+    const link = await titleLink(baseProps({ variant }));
+
+    expect(link.classes).toContain("hover:text-accent");
+    expect(link.classes).toContain("hover:decoration-accent");
+  });
+
+  test("the title link reads as the title, a space, then the new-tab note", async () => {
+    const link = await titleLink(baseProps({ variant }));
+
+    expect(readText(link.inner)).toBe("A very good story (opens in new tab)");
+  });
+
+  test("the new-tab note stays screen-reader only, after a single whitespace character", async () => {
+    const link = await titleLink(baseProps({ variant }));
+
+    expect(link.inner).toMatch(
+      /A very good story\s<span class="sr-only">\(opens in new tab\)<\/span>/,
+    );
+  });
+});
+
+test("a title that ends in punctuation is still separated from the new-tab note", async () => {
+  const link = await titleLink(
+    baseProps({ title: "Is this the end?", variant: "grid" }),
+  );
+
+  expect(readText(link.inner)).toBe("Is this the end? (opens in new tab)");
+});
diff --git a/tests/components/StoryMeta.test.ts b/tests/components/StoryMeta.test.ts
new file mode 100644
index 0000000..def0b74
--- /dev/null
+++ b/tests/components/StoryMeta.test.ts
@@ -0,0 +1,91 @@
+import { describe, test, expect } from "vitest";
+import { experimental_AstroContainer as AstroContainer } from "astro/container";
+import StoryMeta from "../../src/components/StoryMeta.astro";
+import { anchorsTo, classesOfParentOf, elements } from "../support/html";
+
+const STORY_URL = "https://example.com/story";
+const HN_URL = "https://news.ycombinator.com/item?id=1";
+const LOBSTERS_URL = "https://lobste.rs/s/abc";
+const DOMAIN = "example.com";
+
+function baseProps(overrides: Record<string, unknown> = {}) {
+  return {
+    url: STORY_URL,
+    domain: DOMAIN,
+    age: "2h ago",
+    badges: [
+      { label: "HN", points: 150, discussionUrl: HN_URL },
+      { label: "Lobsters", points: 80, discussionUrl: LOBSTERS_URL },
+    ],
+    ...overrides,
+  };
+}
+
+async function render(props: Record<string, unknown>) {
+  const container = await AstroContainer.create();
+  return container.renderToString(StoryMeta, { props });
+}
+
+/** Every class used anywhere in the rendered row. */
+function allClasses(html: string): string[] {
+  return [...html.matchAll(/\bclass="([^"]*)"/g)].flatMap((m) =>
+    m[1].split(/\s+/).filter(Boolean),
+  );
+}
+
+const variants = [
+  { name: "default", compact: false },
+  { name: "compact", compact: true },
+];
+
+describe.each(variants)("$name variant", ({ compact }) => {
+  test("the row sets its text at 12px", async () => {
+    const html = await render(baseProps({ compact }));
+    expect(classesOfParentOf(html, "div", DOMAIN)).toContain("text-xs");
+  });
+
+  test("nothing in the row uses a custom font size below 12px", async () => {
+    const html = await render(baseProps({ compact }));
+    const customSizes = allClasses(html).filter((c) =>
+      /^text-\[[\d.]+(rem|em|px)\]$/.test(c),
+    );
+    expect(customSizes).toEqual([]);
+  });
+
+  test("every source badge link is at least 24px tall and centres its content", async () => {
+    const html = await render(baseProps({ compact }));
+    const badges = [
+      ...anchorsTo(html, HN_URL),
+      ...anchorsTo(html, LOBSTERS_URL),
+    ];
+
+    expect(badges).toHaveLength(2);
+    for (const badge of badges) {
+      expect(badge.classes).toEqual(
+        expect.arrayContaining(["min-h-6", "inline-flex", "items-center"]),
+      );
+    }
+  });
+
+  test("the points number is shown in tabular figures and is not dimmed", async () => {
+    const html = await render(baseProps({ compact }));
+    const [badge] = anchorsTo(html, HN_URL);
+    const points = elements(badge.inner, "span").find(
+      (s) => s.inner.trim() === "150",
+    );
+
+    expect(points).toBeDefined();
+    expect(points!.classes).toContain("tabular-nums");
+    expect(points!.classes.filter((c) => c.includes("opacity-"))).toEqual([]);
+    // No colour of its own either: it inherits the badge's muted colour.
+    expect(points!.classes.filter((c) => c.includes("/"))).toEqual([]);
+  });
+});
+
+test("a class passed by the parent is added to the row without replacing its 12px size", async () => {
+  const html = await render(baseProps({ class: "mt-auto" }));
+  const row = classesOfParentOf(html, "div", DOMAIN);
+
+  expect(row).toContain("mt-auto");
+  expect(row).toContain("text-xs");
+});
